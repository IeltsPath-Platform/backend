[
  {
    "content": "Let's practise this objective.",
    "delay_seconds": 32,
    "tool_calls": [
      {
        "name": "mastery_quiz",
        "arguments": {
          "knowledge_point_id": "${knowledge_point_id}",
          "question": "Which option is correct?",
          "question_type": "choice",
          "options": [
            {"label": "A", "body": "Wrong option"},
            {"label": "B", "body": "Right option"}
          ],
          "expected_answer": "B",
          "explanation": "The second option is correct."
        }
      }
    ]
  },
  {
    "tool_calls": [{"name": "mastery_grade", "arguments": {"answer": "B", "question_id": "${question_id}"}}]
  },
  {"content": "Good work. Your answer has been checked."}
]
