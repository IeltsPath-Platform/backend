digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.18, nodesep=0.45, ranksep=0.8, splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=10, color="#405369", penwidth=1.2, arrowsize=0.8, dir=both];
"assessment.assessment_attempts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Assessment Attempt</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"assessment.attempt_sections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Attempt Section</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  attempt_id</FONT></TD></TR></TABLE>>];
"assessment.attempt_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Attempt Item</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  attempt_section_id</FONT></TD></TR></TABLE>>];
"assessment.attempt_responses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Attempt Response</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  attempt_item_id</FONT></TD></TR></TABLE>>];
"assessment.assessment_results" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Assessment Result</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  attempt_id</FONT></TD></TR></TABLE>>];
"assessment.skill_scores" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Skill Score</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  result_id</FONT></TD></TR></TABLE>>];
"assessment.item_results" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Item Result</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  result_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  attempt_item_id</FONT></TD></TR></TABLE>>];
"assessment.error_analysis_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52667A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DBE7F3"><B>Error Analysis Item</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">FK  item_result_id</FONT></TD></TR></TABLE>>];
"assessment.assessment_attempts" -> "assessment.attempt_sections" [id="0", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.attempt_sections" -> "assessment.attempt_items" [id="1", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.attempt_items" -> "assessment.attempt_responses" [id="2", arrowtail="teetee", arrowhead="teeodot", style="solid"];
"assessment.assessment_attempts" -> "assessment.assessment_results" [id="3", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.assessment_results" -> "assessment.skill_scores" [id="4", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.assessment_results" -> "assessment.item_results" [id="5", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.attempt_items" -> "assessment.item_results" [id="6", arrowtail="teetee", arrowhead="crowodot", style="solid"];
"assessment.item_results" -> "assessment.error_analysis_items" [id="7", arrowtail="teetee", arrowhead="crowodot", style="solid"];
}