# Copy to .env for local development. All values are intentionally blank.
# Required for Compose; generate distinct Base64 JWT secrets of at least 32 bytes.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
EXTERNAL_JWT_SECRET=
GATEWAY_INTERNAL_JWT_SECRET=

# Optional: authentication hardening settings.
# Local Swagger UI; docker-compose.prod.yml forces this off.
API_DOCS_ENABLED=true
APP_AUTH_COOKIE_ENFORCE_SECURE=
APP_AUTH_PASSWORD_MIN_LENGTH=
APP_AUTH_PASSWORD_BCRYPT_COST=
# Optional: Google sign-in client ID from Google Cloud Console.
GOOGLE_CLIENT_IDS=

# Required per service when running from the host (Compose supplies DB passwords).
USER_DB_PASSWORD=
CONTENT_DB_PASSWORD=
LIBRARY_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
ACCESS_DB_PASSWORD=
LEARNING_DB_PASSWORD=
GAME_DB_PASSWORD=
COMMUNITY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# Optional: configure only the features used; keep keys local.
# Learning: Writing, Speaking and Azure Speech
LEARNING_LLM_BASE_URL=
LEARNING_LLM_API_KEY=
LEARNING_LLM_MODEL=
LEARNING_LLM_REASONING_EFFORT=
LEARNING_SPEECH_KEY=
LEARNING_SPEECH_REGION=

# Assessment: essay grading
ASSESSMENT_LLM_BASE_URL=
ASSESSMENT_LLM_API_KEY=
ASSESSMENT_LLM_MODEL=
ASSESSMENT_LLM_REASONING_EFFORT=
ASSESSMENT_PLACEMENT_SPEAKING_GRADING_ENABLED=true

# Content: author drafts (unset CONTENT_LLM_* falls back to matching LEARNING_LLM_*).
CONTENT_LLM_BASE_URL=
CONTENT_LLM_API_KEY=
CONTENT_LLM_MODEL=

# Access: encrypts the full code of each activation key made in a batch (Base64 of 32 random bytes).
# Without it no batch can be made; keys keep activating. Losing it makes old codes unreadable, not unusable.
ACCESS_KEY_CODE_SECRET=

# Storage: User, Content, Library, Assessment, Learning and Community
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CONTENT_MEDIA_BASE_URL=

# Optional observability
GRAFANA_ADMIN_PASSWORD=
