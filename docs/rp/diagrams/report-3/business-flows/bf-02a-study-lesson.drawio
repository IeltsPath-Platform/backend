<mxfile host="app.diagrams.net"><diagram id="bf-02a-study-lesson" name="BF-02a Study a lesson"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="858" pageHeight="820" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Learner" style="swimlane;html=1;startSize=44;fillColor=#e5e7eb;strokeColor=#9ca3af;fontStyle=1;fontSize=17;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="8" y="8" width="300" height="804" as="geometry"/></mxCell><mxCell id="lane1" value="IELTSPath" style="swimlane;html=1;startSize=44;fillColor=#e5e7eb;strokeColor=#9ca3af;fontStyle=1;fontSize=17;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="308" y="8" width="542" height="804" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="145" y="57" width="26" height="26" as="geometry"/></mxCell><mxCell id="choose" value="Choose a lesson" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b6ea8;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="33" y="126" width="250" height="48" as="geometry"/></mxCell><mxCell id="d1" value="Can the lesson&lt;br&gt;be opened?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#8a6100;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="345" y="108" width="210" height="84" as="geometry"/></mxCell><mxCell id="no1" value="Tell the learner why:&lt;br&gt;an earlier lesson or practice&lt;br&gt;is unfinished, a review is&lt;br&gt;waiting, or Premium is needed" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="595" y="104" width="250" height="92" as="geometry"/></mxCell><mxCell id="d2" value="Any hearts&lt;br&gt;left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#8a6100;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="345" y="218" width="210" height="84" as="geometry"/></mxCell><mxCell id="no2" value="Wait for hearts to refill,&lt;br&gt;or buy more with points" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="595" y="229" width="250" height="62" as="geometry"/></mxCell><mxCell id="study" value="Study the lesson, do the&lt;br&gt;exercises and submit" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b6ea8;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="33" y="339" width="250" height="62" as="geometry"/></mxCell><mxCell id="d3" value="Did the answers&lt;br&gt;arrive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#8a6100;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="345" y="428" width="210" height="84" as="geometry"/></mxCell><mxCell id="resend" value="Send again: the same result&lt;br&gt;comes back and is never&lt;br&gt;counted twice" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="595" y="430" width="250" height="80" as="geometry"/></mxCell><mxCell id="d4" value="Scored 70%&lt;br&gt;or more?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#8a6100;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="345" y="538" width="210" height="84" as="geometry"/></mxCell><mxCell id="hint" value="Read the hints; each wrong&lt;br&gt;answer costs a heart" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b6ea8;s