<mxfile host="app.diagrams.net"><diagram id="bf-03-writing-grading" name="BF-03 Writing grading"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1018" pageHeight="750" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Learner" style="swimlane;html=1;startSize=44;fillColor=#e5e7eb;strokeColor=#9ca3af;fontStyle=1;fontSize=17;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="8" y="8" width="300" height="734" as="geometry"/></mxCell><mxCell id="lane1" value="IELTSPath" style="swimlane;html=1;startSize=44;fillColor=#e5e7eb;strokeColor=#9ca3af;fontStyle=1;fontSize=17;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="308" y="8" width="492" height="734" as="geometry"/></mxCell><mxCell id="lane2" value="AI Grading" style="swimlane;html=1;startSize=44;fillColor=#e5e7eb;strokeColor=#9ca3af;fontStyle=1;fontSize=17;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="800" y="8" width="210" height="734" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="145" y="57" width="26" height="26" as="geometry"/></mxCell><mxCell id="write" value="Write the essay&lt;br&gt;and submit it" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b6ea8;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="33" y="119" width="250" height="62" as="geometry"/></mxCell><mxCell id="d1" value="Allowed to&lt;br&gt;submit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#8a6100;strokeWidth=1.5;fontSize=15;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="345" y="108" width="210" height="84" as="geometry"/></mxCell><mxCell id="s1" value="Tell the learner why: not&lt;br&gt;enough points or the&lt;br&gt;daily l