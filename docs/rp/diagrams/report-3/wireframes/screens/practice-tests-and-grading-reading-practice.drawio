ne;" vertex="1" parent="1"><mxGeometry x="14.4" y="130.0" width="524.4" height="509.2" as="geometry"/></mxCell><mxCell id="c17" value="Keeping cities cool" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=18.4;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="191.6" y="147.1" width="214.8" height="24.8" as="geometry"/></mxCell><mxCell id="c18" value="Cities have always been warmer than the countryside around them." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="192.1" width="533.0" height="20.7" as="geometry"/></mxCell><mxCell id="c19" value="Dark roofs and roads soak up sunlight during the day and give the" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="218.2" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c20" value="heat back at night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="244.3" width="166.7" height="20.7" as="geometry"/></mxCell><mxCell id="c21" value="Planting trees is one of the cheapest ways to cool a street. Shade" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="286.5" width="549.3" height="20.7" as="geometry"/></mxCell><mxCell id="c22" value="keeps pavements from heating up, and water leaving the leaves" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="312.6" width="508.6" height="20.7" as="geometry"/></mxCell><mxCell id="c23" value="lowers the air temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="338.7" width="231.8" height="20.7" as="geometry"/></mxCell><mxCell id="c24" value="Some cities now paint roofs white. Early results suggest that the" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="380.8" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c25" value="rooms underneath need far less power for cooling in the hottest" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="406.9" width="524.9" height="20.7" as="geometry"/></mxCell><mxCell id="c26" value="months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="17.6" y="433.0" width="69.0" height="20.7" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;absoluteArcSize=1;arcSize=6.0;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="538.8" y="369.4" width="22.4" height="30.4" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="544.0" y="378.6" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561.2" y="130.0" width="524.4" height="509.2" as="geometry"/></mxCell><mxCell id="c30" value="Questions 1 - 5" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580.4" y="134.3" width="165.1" height="23.8" as="geometry"/></mxCell><mxCell id="c31" value="Do the following statements agree with the information?" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580.4" y="169.1" width="394.4" height="17.7" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="580.4" y="202.3" width="21.6" height="21.6" as="geometry"/></mxCell><mxCell id="c33" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="587.5" y="205.0" width="18.7" height="15.6" as="geometry"/></mxCell><mxCell id="c34" value="City surfaces release stored heat after sunset." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.72;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="611.6" y="203.8" width="378.7" height="19.9" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="580.4" y="230.8" width="495.6" height="44.5" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;absoluteArcSize=1;arcSize=17.6;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="594.8" y="244.2" width="17.6" height="17.6" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#555555;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="599.6" y="249.0" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="c38" value="TRUE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.72;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="624.4" y="243.4" width="43.2" height="19.9" as="geometry"/></mxCell