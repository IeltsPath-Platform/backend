="c34" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="110.0" y="152.0" width="976.0" height="1124.3" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="173.0" width="930.0" height="90.0" as="geometry"/></mxCell><mxCell id="c36" value="Task question" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="191.6" width="122.2" height="21.6" as="geometry"/></mxCell><mxCell id="c37" value="Some people think cities need more public gardens. Discuss." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="223.6" width="512.3" height="21.6" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="279.0" width="930.0" height="114.0" as="geometry"/></mxCell><mxCell id="c39" value="Essay" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="297.6" width="54.4" height="21.6" as="geometry"/></mxCell><mxCell id="c40" value="Many cities now build small gardens on roofs. In my view this is useful because people can rest near their homes." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="329.6" width="970.2" height="21.6" as="geometry"/></mxCell><mxCell id="c41" value="However, gardens cost money to keep." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="353.6" width="317.3" height="21.6" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="409.0" width="930.0" height="58.0" as="geometry"/></mxCell><mxCell id="c43" value="Reference rubric" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="166.9" y="427.6" width="147.7" height="21.6" as="geometry"/></mxCell><mxCell id="c44" value="This is blind grading. Follow the rubric; do not guess the Examiner's score." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="133.0" y="484.6" width="656.5" height="21.6" as="geometry"/></mxCell><mxCell id="c45" value="Task Response / Achievement" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="133.0" y="524.2" width="225.0" height="18.4" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="549.4" width="930.0" height="42.0" as="geometry"/></mxCell><mxCell id="c47" value="6" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="144.0" y="560.0" width="20.5" height="21.6" as="geometry"/></mxCell><mxCell id="c48" value="▾" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12;fontColor=#777777;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1047.0" y="562.4" width="18.4" height="16.2" as="geometry"/