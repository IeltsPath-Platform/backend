mxCell id="c50" value="Skip checks" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.72;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="77.5" y="546.2" width="105.9" height="19.9" as="geometry"/></mxCell><mxCell id="c51" value="Do at least one to be able to skip." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="205.0" y="546.8" width="264.3" height="18.4" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="33.0" y="628.5" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c53" value="Theory to remember" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=20;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="624.0" width="220.8" height="27.0" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;absoluteArcSize=1;arcSize=36.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="32.0" y="668.8" width="1136.0" height="122.9" as="geometry"/></mxCell><mxCell id="c55" value="SECTION A" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=10.88;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="53.0" y="686.8" width="68.8" height="14.7" as="geometry"/></mxCell><mxCell id="c56" value="Paraphrase" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.92;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="53.0" y="703.6" width="115.9" height="24.2" as="geometry"/></mxCell><mxCell id="c57" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1118.0" y="698.4" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c58" value="The question says the same idea with other words." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="53.0" y="747.2" width="410.9" height="20.7" as="geometry"/></mxCell><mxCell id="c59" value="" style="rounded=1;absoluteArcSize=1;arcSize=32.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="32.0" y="819.8" width="1136.0" height="714.2" as="geometry"/></mxCell><mxCell id="c60" style="endArrow=none;strokeColor=#c4c4c4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632.1" y="820.8" as="sourcePoint"/><mxPoint x="632.1" y="2210.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="" style="rounded=1;absoluteArcSize=1;arcSize=32.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="33.0" y="820.8" width="598.1" height="134.5" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="55.0" y="847.0" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c63" value="Review audio" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80.8" y="843.3" width="128.9" height="22.7" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=1;absoluteArcSize=1;arcSize=26.5;fillColor=#f3f3f3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576.1" y="841.8" width="34.0" height="26.5" as="geometry"/></mxCell><mxCell id="c65" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.44;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="584.9" y="846.2" width="19.8" height="18.1" as="geometry"/></mxCell><mxCell id="c66" value="s" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.44;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="593.6" y="846.2" width="19.8" height="18.1" as="geometry"/></mxCell><mxCell id="c67" value="READING PASSAGE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="61.0" y="980.5" width="123.4" height="17.3" as="geometry"/></mxCell><mxCell id="c68" value="Cities have always been warmer than the countryside around them. Dark" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1030.6" width="573.7" height="20.7" as="geometry"/></mxCell><mxCell id="c69" value="roofs and roads soak up sunlight during the day and give the heat back at" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1057.5" width="606.3" height="20.7" as="geometry"/></mxCell><mxCell id="c70" value="night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1084.3" width="60.8" height="20.7" as="geometry"/></mxCell><mxCell id="c71" value="Planting trees is one of the cheapest ways to cool a street. Shade keeps" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1123.2" width="598.1" height="20.7" as="geometry"/></mxCell><mxCell id="c72" value="pavements from heating up, and water leaving the leaves lowers the air" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1150.1" width="581.9" height="20.7" as="geometry"/></mxCell><mxCell id="c73" value="temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1177.0" width="109.7" height="20.7" as="geometry"/></mxCell><mxCell id="c74" value="Some cities now paint roofs white. Early results suggest that the rooms" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1215.8" width="590.0" height="20.7" as="geometry"/></mxCell><mxCell id="c75" value="underneath need far less power for cooling in the hottest months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="1242.7" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c76" value="EXERCISES" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="845.9" width="78.8" height="17.3" as="geometry"/></mxCell><mxCell id="c77" value="Set 3/3 · 00006002" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.28;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="869.3" width="192.4" height="23.3" as="geometry"/></mxCell><mxCell id="c78" value="Answer the questions below." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660.1" y="908.6" width="213.5" height="19.0" as="geometry"/></mxCell><mxCell id="c79" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.2" y="963.1" width="21.1" height="21.2" as="geometry"/></mxCell><mxCell id="c80" value="Planting trees can lower the temperature of a street." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="692.1" y="963.1" width="494.0" height="21.2" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1009.7" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c82" value="TRUE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1007.1" width="43.9" height="20.3" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1055.3" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c84" value="FALSE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1052.7" width="51.9" height="20.3" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1100.9" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c86" value="NOT GIVEN" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1098.3" width="83.7" height="20.3" as="geometry"/></mxCell><mxCell id="c87" style="endArrow=none;strokeColor=#c4c4c4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.1" y="1148.5" as="sourcePoint"/><mxPoint x="1139.0" y="1148.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c88" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.2" y="1168.4" width="21.1" height="21.2" as="geometry"/></mxCell><mxCell id="c89" value="Painting roofs white costs more than planting trees." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="692.1" y="1168.4" width="484.9" height="21.2" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1215.0" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c91" value="TRUE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1212.4" width="43.9" height="20.3" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1260.5" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c93" value="FALSE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1258.0" width="51.9" height="20.3" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="1306.1" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c95" value="NOT GIVEN" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="1303.6" width="