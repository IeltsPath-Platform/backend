/mxCell><mxCell id="c58" value="READING PASSAGE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="61.0" y="405.3" width="123.4" height="17.3" as="geometry"/></mxCell><mxCell id="c59" value="Cities have always been warmer than the countryside around them. Dark" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="455.4" width="573.7" height="20.7" as="geometry"/></mxCell><mxCell id="c60" value="roofs and roads soak up sunlight during the day and give the heat back at" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="482.3" width="606.3" height="20.7" as="geometry"/></mxCell><mxCell id="c61" value="night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="509.2" width="60.8" height="20.7" as="geometry"/></mxCell><mxCell id="c62" value="Planting trees is one of the cheapest ways to cool a street. Shade keeps" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="548.0" width="598.1" height="20.7" as="geometry"/></mxCell><mxCell id="c63" value="pavements from heating up, and water leaving the leaves lowers the air" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="574.9" width="581.9" height="20.7" as="geometry"/></mxCell><mxCell id="c64" value="temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="601.8" width="109.7" height="20.7" as="geometry"/></mxCell><mxCell id="c65" value="Some cities now paint roofs white. Early results suggest that the rooms" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="640.7" width="590.0" height="20.7" as="geometry"/></mxCell><mxCell id="c66" value="underneath need far less power for cooling in the hottest months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="667.5" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c67" value="PART" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="405.3" width="41.7" height="17.3" as="geometry"/></mxCell><mxCell id="c68" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="702.3" y="405.3" width="19.4" height="17.3" as="geometry"/></mxCell><mxCell id="c69" value="/" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="711.4" y="405.3" width="19.4" height="17.3" as="geometry"/></mxCell><mxCell id="c70" value="3" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="717.6" y="405.3" width="19.4" height="17.3" as="geometry"/></mxCell><mxCell id="c71" value="Urban trees" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=20;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="428.4" width="139.6" height="27.0" as="geometry"/></mxCell><mxCell id="c72" value="Choose the correct answer." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660.1" y="470.6" width="206.0" height="19.0" as="geometry"/></mxCell><mxCell id="c73" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.2" y="525.1" width="21.1" height="21.2" as="geometry"/></mxCell><mxCell id="c74" value="Planting trees can lower the temperature of a street." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="692.1" y="525.1" width="494.0" height="21.2" as="geometry"/></mxCell><mxCell id="c75" value="" style="rounded=1;absoluteArcSize=1;arcSize=20.0;fillColor=#f3f3f3;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="692.1" y="557.7" width="446.9" height="44.0" as="geometry"/></mxCell><mxCell id="c76" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="703.3" y="571.7" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c77" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#f3f3f3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="707.3" y="575.7" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="c78" value="TRUE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.04;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="729.7" y="569.1" width="43.9" height="20.3" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent=