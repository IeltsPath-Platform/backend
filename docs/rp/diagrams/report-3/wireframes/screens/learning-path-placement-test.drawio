o time limit" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="269.1" y="33.6" width="120.1" height="18.4" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;absoluteArcSize=1;arcSize=40.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="1028.0" y="12.2" width="40.0" height="40.0" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040.0" y="24.2" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;absoluteArcSize=1;arcSize=20.0;fillColor=#f3f3f3;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="32.0" y="76.4" width="1036.0" height="79.6" as="geometry"/></mxCell><mxCell id="c41" value="Passage 1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="49.0" y="92.6" width="95.5" height="21.6" as="geometry"/></mxCell><mxCell id="c42" value="Answer the questions." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="49.0" y="119.0" width="190.1" height="21.6" as="geometry"/></mxCell><mxCell id="c43" value="Keeping cities cool" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=20;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32.0" y="175.5" width="232.4" height="27.0" as="geometry"/></mxCell><mxCell id="c44" value="Cities have always been warmer than the countryside around" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="205.6" width="503.8" height="21.6" as="geometry"/></mxCell><mxCell id="c45" value="them. Dark roofs and roads soak up sunlight during the day and" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="233.6" width="537.8" height="21.6" as="geometry"/></mxCell><mxCell id="c46" value="give the heat back at night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="261.6" width="249.4" height="21.6" as="geometry"/></mxCell><mxCell id="c47" value="Planting trees is one of the cheapest ways to cool a street. Shade" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="307.2" width="571.7" height="21.6" as="geometry"/></mxCell><mxCell id="c48" value="keeps pavements from heating up, and water leaving the leaves" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="335.2" width="529.3" height="21.6" as="geometry"/></mxCell><mxCell id="c49" value="lowers the air temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="363.2" width="241.0" height="21.6" as="geometry"/></mxCell><mxCell id="c50" value="Some cities now paint roofs white. Early results suggest that the" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="408.8" width="563.2" height="21.6" as="geometry"/></mxCell><mxCell id="c51" value="rooms underneath need far less power for cooling in the hottest" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="436.8" width="546.2" height="21.6" as="geometry"/></mxCell><mxCell id="c52" value="months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32.0" y="464.8" width="71.4" height="21.6" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="554.0" y="387.6" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561.0" y="394.6" width="14.0" height="14.0" as="geometry"/></mxCell><mxCell id="c55" value="Questions 1–2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.28;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594.0" y="175.8" width="142.3" height="23.3" as="geometry"/></mxCell><mxCell id="c56" value="Do the following statements agree with the information given" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="594.0" y="206.5" width="520.8" height="21.6" as="geometry"/></mxCell><mxCell id="c57" value="in the passage?" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="594.0" y="230.5" width="139.2" height="21.6" as="geometry"/></mxCell><mxCell id="c58" value="TRUE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594.0" y="260.1" width="49.1" height="21.6" as="geometry"/></mxCell><mxCell id="c59" value="if the statement agrees with the information" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="694.0" y="260.1" width="385.1" height="21.6" as="geometry"/></mxCell><mxCell id="c60" value="FALSE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594.0" y="285.7" width="58.4" height="21.6" as="geometry"/></mxCell><mxCell id="c61" value="if the statement contradicts the information" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="694.0" y="285.7" width="385.1" height="21.6" as="geometry"/></mxCell><mxCell id="c62" value="NOT GIVEN" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594.0" y="311.3" width="95.5" height="21.6" as="geometry"/></mxCell><mxCell id="c63" value="if there is no information on this" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="695.4" y="311.3" width="300.3" height="21.6" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=none;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="594.0" y="359.3" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c65" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="604.5" y="362.1" width="21.3" height="21.6" as="geometry"/></mxCell><mxCell id="c66" value="Planting trees can lower the temperature of a street." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;alig