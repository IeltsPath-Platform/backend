ing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="27.6" y="194.3" width="58.8" height="15.6" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="228.1" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c28" value="Grade" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32.1" y="251.6" width="45.4" height="15.6" as="geometry"/></mxCell><mxCell id="c29" value="Speaking" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="23.0" y="268.8" width="65.5" height="15.6" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="302.6" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c31" value="Knowledge" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="17.6" y="326.1" width="72.1" height="15.6" as="geometry"/></mxCell><mxCell id="c32" value="tree" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.52;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38.0" y="343.4" width="38.7" height="15.6" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="110.0" y="76.0" width="976.0" height="89.2" as="geometry"/></mxCell><mxCell id="c34" value="Grade a Writing essay" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="129.0" y="88.1" width="216.6" height="22.7" as="geometry"/></mxCell><mxCell id="c35" value="Task 2 · Practice. You do not see the Learner name. Grade by the rubric and mark errors in the" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="129.0" y="113.3" width="665.6" height="17.7" as="geometry"/></mxCell><mxCell id="c36" value="essay." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="129.0" y="133.0" width="53.7" height="17.7" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="931.1" y="101.6" width="135.9" height="38.0" as="geometry"/></mxCell><mxCell id="c38" value="List of essays" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="946.1" y="110.2" width="141.9" height="21.6" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="110.0" y="177.2" width="976.0" height="922.8" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="686.5" y="198.2" width="124.4" height="34.0" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="698.5" y="208.7" width="13.0" height="13.0" as="geometry"/></mxCell><mxCell id="c42" value="Wider essay" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="718.5" y="206.2" width="98.8" height="18.4" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="816.8" y="198.2" width="103.9" height="34.0" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="828.8" y="208.7" width="13.0" height="13.0" as="geometry"/></mxCell><mxCell id="c45" value="Balanced" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848.8" y="206.2" width="75.1" height="18.4" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="926.8" y="198.2" width="136.3" height="34.0" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="938.8" y="208.7" width="13.0" height="13.0" as="geometry"/></mxCell><mxCell id="c48" value="Wider grading" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="958.8" y="206.2" width="114.5" height="18.4" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="242.2" width="518.4" height="122.0" as="geometry"/></mxCell><mxCell id="c50" value="Task" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="260.8" width="45.9" height="21.6" as="geometry"/></mxCell><mxCell id="c51" value="Some people think that cities should build more cycle lanes" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="294.8" width="512.3" height="21.6" as="geometry"/></mxCell><mxCell id="c52" value="instead of new roads. To what extent do you agree or disagree?" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="322.8" width="537.8" height="21.6" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="378.2" width="518.4" height="532.0" as="geometry"/></mxCell><mxCell id="c54" value="Essay of the Learner" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="396.8" width="181.6" height="21.6" as="geometry"/></mxCell><mxCell id="c55" value="Select the faulty part and fill in the form below. Read-only: you" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="428.8" width="563.2" height="21.6" as="geometry"/></mxCell><mxCell id="c56" value="cannot edit the essay." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="452.8" width="198.6" height="21.6" as="geometry"/></mxCell><mxCell id="c57" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#f3f3f3;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="150.0" y="475.2" width="484.4" height="418.0" as="geometry"/></mxCell><mxCell id="c58" value="Many cities are crowded with cars today. In my opinion," style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="491.8" width="478.4" height="21.6" as="geometry"/></mxCell><mxCell id="c59" value="building more cycle lanes is a sensible idea, but it cannot" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="519.8" width="512.3" height="21.6" as="geometry"/></mxCell><mxCell id="c60" value="fully replace new roads." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="547.8" width="215.5" height="21.6" as="geometry"/></mxCell><mxCell id="c61" value="Firstly," style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="603.8" width="79.8" height="21.6" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;absoluteArcSize=1;arcSize=4.0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="219.4" y="604.2" width="129.8" height="22.0" as="geometry"/></mxCell><mxCell id="c63" style="endArrow=none;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="219.4" y="626.2" as="sourcePoint"/><mxPoint x="349.2" y="626.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="cycle lanes helps" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="219.4" y="603.8" width="156.2" height="21.6" as="geometry"/></mxCell><mxCell id="c65" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.2;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350.2" y="603.3" width="18.5" height="15.1" as="geometry"/></mxCell><mxCell id="c66" value="people to travel cheaply. When" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="359.6" y="603.8" width="266.4" height="21.6" as="geometry"/></mxCell><mxCell id="c67" value="lanes are safe, more residents choose a bicycle for short" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="631.8" width="495.4" height="21.6" as="geometry"/></mxCell><mxCell id="c68" value="trips, which reduce traffic and air pollution." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="659.8" width="402.1" height="21.6" as="geometry"/></mxCell><mxCell id="c69" value="However, roads are still necessary for buses, ambulances" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="715.8" width="486.9" height="21.6" as="geometry"/></mxCell><mxCell id="c70" value="and goods." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="743.8" width="96.8" height="21.6" as="geometry"/></mxCell><mxCell id="c71" value="" style="rounded=1;absoluteArcSize=1;arcSize=4.0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="254.1" y="744.2" width="79.8" height="22.0" as="geometry"/></mxCell><mxCell id="c72" style="endArrow=none;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="254.1" y="766.2" as="sourcePoint"/><mxPoint x="333.8" y="766.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value="A city who" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="254.1" y="743.8" width="96.8" height="21.6" as="geometry"/></mxCell><mxCell id="c74" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.2;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="334.8" y="743.3" width="18.5" height="15.1" as="geometry"/></mxCell><mxCell id="c75" value="only builds cycle lanes may make" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="346.4" y="743.8" width="283.4" height="21.6" as="geometry"/></mxCell><mxCell id="c76" value="delivery slower." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="771.8" width="147.7" height="21.6" as="geometry"/></mxCell><mxCell id="c77" value="In conclusion, governments should give more space to" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="827.8" width="453.0" height="21.6" as="geometry"/></mxCell><mxCell id="c78" value="cyclists while keeping important roads in good condition." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="855.8" width="495.4" height="21.6" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="924.2" width="518.4" height="168.0" as="geometry"/></mxCell><mxCell id="c80" value="Errors recorded (" style="text;ht