eft;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="275.1" width="512.3" height="21.6" as="geometry"/></mxCell><mxCell id="c52" value="instead of new roads. To what extent do you agree or disagree?" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="303.1" width="537.8" height="21.6" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="150.0" y="339.5" width="484.4" height="193.2" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=0;fillColor=#eeeeee;strokeColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="157.0" y="346.5" width="470.4" height="179.2" as="geometry"/></mxCell><mxCell id="c55" style="endArrow=none;strokeColor=#bbbbbb;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="157.0" y="346.5" as="sourcePoint"/><mxPoint x="627.4" y="525.7" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="endArrow=none;strokeColor=#bbbbbb;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="627.4" y="346.5" as="sourcePoint"/><mxPoint x="157.0" y="525.7" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="" style="rounded=1;absoluteArcSize=1;arcSize=12.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="150.0" y="540.7" width="129.5" height="30.0" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="162.0" y="549.7" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c59" value="Enlarge chart" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="181.0" y="546.7" width="114.5" height="18.4" as="geometry"/></mxCell><mxCell id="c60" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="133.0" y="601.7" width="518.4" height="184.8" as="geometry"/></mxCell><mxCell id="c61" value="Essay of the Learner" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150.0" y="620.3" width="181.6" height="21.6" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#f3f3f3;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="150.0" y="650.7" width="484.4" height="135.8" as="geometry"/></mxCell><mxCell id="c63" value="Many cities are crowded with cars today. In my opinion," style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="667.3" width="478.4" height="21.6" as="geometry"/></mxCell><mxCell id="c64" value="building more cycle lanes is a sensible idea, but it cannot" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="695.3" width="512.3" height="21.6" as="geometry"/></mxCell><mxCell id="c65" value="fully replace new roads." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="723.3" width="215.5" height="21.6" as="geometry"/></mxCell><mxCell id="c66" value="Firstly," style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="165.0" y="779.3" width="79.8" height="21.6" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;absoluteArcSize=1;arcSize=4.0;fillColor=#e3