try"/></mxCell><mxCell id="c148" value="Evidence:" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="577.6" y="1111.4" width="80.5" height="17.7" as="geometry"/></mxCell><mxCell id="c149" value="“" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="644.9" y="1111.4" width="19.0" height="17.7" as="geometry"/></mxCell><mxCell id="c150" value="This reduce traffic" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650.6" y="1111.4" width="144.1" height="17.7" as="geometry"/></mxCell><mxCell id="c151" value="”" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.12;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="763.8" y="1111.4" width="19.0" height="17.7" as="geometry"/></mxCell><mxCell id="c152" value="Band description:" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.48;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="577.6" y="1135.1" width="135.1" height="16.8" as="geometry"/></mxCell><mxCell id="c153" value="Addresses the task with a generally clear position." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.48;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="688.8" y="1135.1" width="349.3" height="16.8" as="geometry"/></mxCell><mxCell id="c154" value="Your essay, marked" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=20;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16.0" y="1200.0" width="220.8" height="27.0" as="geometry"/></mxCell><mxCell id="c155" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="16.0" y="1244.0" width="1068.0" height="276.5" as="geometry"/></mxCell><mxCell id="c156" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="39.4" y="1264.2" width="62.0" height="21.8" as="geometry"/></mxCell><mxCell id="c157" value="Grammar" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=11.2;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45.0" y="1267.7" width="57.5" height="15.1" as="geometry"/></mxCell><mxCell id="c158" value="Many cities are crowded with private cars. I strongly agree that free public transport would help to solve this problem." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="1302.3" width="1029.6" height="21.6" as="geometry"/></mxCell><mxCell id="c159" value="Firstly," style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="1359.9" width="79.8" height="21.6" as="geometry"/></mxCell><mxCell id="c160" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="93.8" y="1359.5" width="86.5" height="21.6" as="geometry"/></mxCell><mxCell id="c161" value="people is" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="99.4" y="1359.9" width="88.3" height="21.6" as="geometry"/></mxCell><mxCell id="c162" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=9.92;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170.3" y="1360.9" width="17.8" height="13.4" as="geometry"/></mxCell><mxCell id="c163" value="more likely to leave their cars at home when a bus ride costs nothing." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="184.8" y="1359.9" width="605.6" height="21.6" as="geometry"/></mxCell><mxCell id="c164" value="" style="rounded=1;absoluteArcSize=1;arcSize=8.0;fillColor=#e3e3e3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="712.4" y="1359.5" width="109.3" height="21.6" as="geometry"/></mxCell><mxCell id="c165" value="This reduce" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="718.0" y="1359.9" width="105.3" height="21.6" as="geometry"/></mxCell><mxCell id="c166" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=9.92;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="809.8" y="1360.9" width="17.8" height="13.4" as="geometry"/></mxCell><mxCell id="c167" value="traffic and pollution." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="826.2" y="1359.9" width="198.6" height="21.6" as="geometry"/></mxCell><mxCell id="c168" value="Secondly, low income families would save money every month and could reach more jobs." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="1417.5" width="732.8" height="21.6" as="geometry"/></mxCell><mxCell id="c169" value="In conclusion, the benefits of free transport are larger than its cost." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="1475.1" width="614.1" height="21.6" as="geometry"/></mxCell><mxCell id="c170" value="" style="rounded=1;absoluteArcSize=1;arcSize=32.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="16.0" y="1536.5" width="1068.0" height="271.0" as="geometry"/></mxCell><mxCell id="c171" value="Errors to fix" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=18.4;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42.6" y="1560.9" width="150.7" height="24.8" as="geometry"/></mxCell><mxCell id="c172" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1004.5" y="1565.3" width="19.5" height="19.0" as="geometry"/></mxCell><mxCell id="c173" value="errors" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1017.4" y="1565.3" width="56.8" height="19.0" as="geometry"/></mxCell><mxCell id="c174" style="endArrow=none;strokeColor=#c4c4c4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42.6" y="1650.1" as="sourcePoint"/><mxPoint x="1057.4" y="1650.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c175" value="All" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.72;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42.6" y="1617.5" width="37.6" height="19.9" as="geometry"/></mxCell><mxCell id="c176" value="2" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="69.1" y="1619.2" width="19.4" height="17.3" as="geometry"/></mxCell><mxCell id="c177" value="Grammar" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.72;fontColor=#333333;align=left;vert