rrow=none;strokeColor=#c4c4c4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632.1" y="319.1" as="sourcePoint"/><mxPoint x="632.1" y="1207.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=32.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="33.0" y="319.1" width="598.1" height="134.5" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="55.0" y="345.3" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c37" value="Check audio" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80.8" y="341.6" width="119.2" height="22.7" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;absoluteArcSize=1;arcSize=26.5;fillColor=#f3f3f3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576.1" y="340.1" width="34.0" height="26.5" as="geometry"/></mxCell><mxCell id="c39" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.44;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="584.9" y="344.5" width="19.8" height="18.1" as="geometry"/></mxCell><mxCell id="c40" value="s" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.44;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="593.6" y="344.5" width="19.8" height="18.1" as="geometry"/></mxCell><mxCell id="c41" value="READING PASSAGE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="61.0" y="478.8" width="123.4" height="17.3" as="geometry"/></mxCell><mxCell id="c42" value="Cities have always been warmer than the countryside around them. Dark" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="528.9" width="573.7" height="20.7" as="geometry"/></mxCell><mxCell id="c43" value="roofs and roads soak up sunlight during the day and give the heat back at" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="555.8" width="606.3" height="20.7" as="geometry"/></mxCell><mxCell id="c44" value="night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="582.6" width="60.8" height="20.7" as="geometry"/></mxCell><mxCell id="c45" value="Planting trees is one of the cheapest ways to cool a street. Shade keeps" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="621.5" width="598.1" height="20.7" as="geometry"/></mxCell><mxCell id="c46" value="pavements from heating up, and water leaving the leaves lowers the air" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="648.4" width="581.9" height="20.7" as="geometry"/></mxCell><mxCell id="c47" value="temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="675.3" width="109.7" height="20.7" as="geometry"/></mxCell><mxCell id="c48" value="Some cities now paint roofs white. Early results suggest that the rooms" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="714.1" width="590.0" height="20.7" as="geometry"/></mxCell><mxCell id="c49" value="underneath need far less power for cooling in the hottest months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61.0" y="741.0" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c50" value="EXERCISES" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="344.2" width="78.8" height="17.3" as="geometry"/></mxCell><mxCell id="c51" value="Check earlier knowledge" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.28;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660.1" y="367.6" width="242.5" height="23.3" as="geometry"/></mxCell><mxCell id="c52" value="Answer the questions below." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660.1" y="406.9" width="213.5" height="19.0" as="geometry"/></mxCell><mxCell id="c53" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.2" y="461.4" width="21.1" height="21.2" as="geometry"/></mxCell><mxCell id="c54" value="Planting trees can lower the temperature of a street." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="692.1" y="461.4" width="494.0" height="21.2" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=none;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="703.3" y="508.0" width="16.0" height="16.0"