geometry"/></mxCell><mxCell id="c58" value="READING PASSAGE" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="121.0" y="614.9" width="123.4" height="17.3" as="geometry"/></mxCell><mxCell id="c59" value="Cities have always been warmer than the countryside around them. Dark" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="665.0" width="573.7" height="20.7" as="geometry"/></mxCell><mxCell id="c60" value="roofs and roads soak up sunlight during the day and give the heat back at" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="691.9" width="606.3" height="20.7" as="geometry"/></mxCell><mxCell id="c61" value="night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="718.8" width="60.8" height="20.7" as="geometry"/></mxCell><mxCell id="c62" value="Planting trees is one of the cheapest ways to cool a street. Shade keeps" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="757.7" width="598.1" height="20.7" as="geometry"/></mxCell><mxCell id="c63" value="pavements from heating up, and water leaving the leaves lowers the air" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="784.5" width="581.9" height="20.7" as="geometry"/></mxCell><mxCell id="c64" value="temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="811.4" width="109.7" height="20.7" as="geometry"/></mxCell><mxCell id="c65" value="Some cities now paint roofs white. Early results suggest that the rooms" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="850.3" width="590.0" height="20.7" as="geometry"/></mxCell><mxCell id="c66" value="underneath need far less power for cooling in the hottest months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="121.0" y="877.2" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c67" value="EXERCISES" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=12.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="741.2" y="444.3" width="78.8" height="17.3" as="geometry"/></mxCell><mxCell id="c68" value="Paraphrase practice: city trees" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.28;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="741.2" y="467.7" width="322.7" height="23.3" as="geometry"/></mxCell><mxCell id="c69" value="Answer every question. Passing counts for the lesson practice." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=14.08;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="741.2" y="507.0" width="474.7" height="19.0" as="geometry"/></mxCell><mxCell id="c70" value="1" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.68;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="747.3" y="561.5" width="21.1" height="21.2" as="geometry"/></mxCell><mxCell id="c71" value="Planting trees can lower 