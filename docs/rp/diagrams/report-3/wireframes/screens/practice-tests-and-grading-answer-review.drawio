<mxfile host="app.diagrams.net"><diagram id="wireframe" name="Answer Review"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="" style="rounded=0;fillColor=#f3f3f3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="1100.0" height="700.0" as="geometry"/></mxCell><mxCell id="c1" value="" style="rounded=1;absoluteArcSize=1;arcSize=32.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="14.4" y="8.8" width="32.0" height="32.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;fillColor=#bdbdbd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="23.4" y="17.8" width="14.0" height="14.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;absoluteArcSize=1;arcSize=30.0;fillColor=#555555;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="459.0" y="9.8" width="181.9" height="30.0" as="geometry"/></mxCell><mxCell id="c4" value="3" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="476.6" y="15.8" width="19.9" height="18.4" as="geometry"/></mxCell><mxCell id="c5" value="/" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="485.4" y="15.8" width="19.9" height="18.4" as="geometry"/></mxCell><mxCell id="c6" value="5" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490.7" y="15.8" width="19.9" height="18.4" as="geometry"/></mxCell><mxCell id="c7" value="correct ·" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="503.2" y="15.8" width="83.0" height="18.4" as="geometry"/></mxCell><mxCell id="c8" value="00:16:00" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=13.6;fontColor=#ffffff;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="563.3" y="15.8" width="75.1" height="18.4" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="14.4" y="49.6" width="528.4" height="583.4" as="geometry"/></mxCell><mxCell id="c10" value="Keeping cities cool" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=16.8;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="201.0" y="67.7" width="197.1" height="22.7" as="geometry"/></mxCell><mxCell id="c11" value="Cities have always been warmer than the countryside around" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="110.3" width="484.2" height="20.7" as="geometry"/></mxCell><mxCell id="c12" value="them. Dark roofs and roads soak up sunlight during the day and" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="136.4" width="516.7" height="20.7" as="geometry"/></mxCell><mxCell id="c13" value="give the heat back at night." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="162.5" width="239.9" height="20.7" as="geometry"/></mxCell><mxCell id="c14" value="Planting trees is one of the cheapest ways to cool a street. Shade" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="204.6" width="549.3" height="20.7" as="geometry"/></mxCell><mxCell id="c15" value="keeps pavements from heating up, and water leaving the leaves" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="230.7" width="508.6" height="20.7" as="geometry"/></mxCell><mxCell id="c16" value="lowers the air temperature." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="256.8" width="231.8" height="20.7" as="geometry"/></mxCell><mxCell id="c17" value="Some cities now paint roofs white. Early results suggest that the" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="298.9" width="541.2" height="20.7" as="geometry"/></mxCell><mxCell id="c18" value="rooms underneath need far less power for cooling in the hottest" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="325.0" width="524.9" height="20.7" as="geometry"/></mxCell><mxCell id="c19" value="months." style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=15.36;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="39.4" y="351.2" width="69.0" height="20.7" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;absoluteArcSize=1;arcSize=16.0;fillColor=#ffffff;strokeColor=#b5b5b5;" vertex="1" parent="1"><mxGeometry x="557.2" y="49.6" width="528.4" height="583.4" as="geometry"/></mxCell><mxCell id="c21" value="Questions 1 - 5" style="text;html=0;spacing=0;fontFamily=Segoe UI;fontSize=17.6;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580.6" y=