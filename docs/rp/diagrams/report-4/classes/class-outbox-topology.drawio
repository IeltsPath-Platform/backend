<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="class-outbox-topology" name="class-outbox-topology"><mxGraphModel dx="1700" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;assessment-service&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;RabbitOutboxEventPublisher&lt;/b&gt;&lt;hr size="1"&gt;persistent message,&lt;br&gt;messageId = outbox event id' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="270" height="84" as="geometry"/></mxCell><mxCell id="c3" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;topic exchange, durable&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;assessment.events&lt;/b&gt;&lt;hr size="1"&gt;routing key&lt;br&gt;assessment.completed.v2' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="260" height="84" as="geometry"/></mxCell><mxCell id="c4" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;queue&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;notification.assessment-result-ready.v2&lt;/b&gt;&lt;hr size="1"&gt;bound to the assessment.events exchange' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="360" height="68" as="geometry"/></mxCell><mxCell id="c5" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;notification-service&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AssessmentResultReadyListener&lt;/b&gt;&lt;hr size="1"&gt;reads the same event for the&lt;br&gt;"result ready" notice' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="400" height="84" as="geometry"/></mxCell><mxCell id="c6" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;queue, durable&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;learning.assessment-completed.v2&lt;/b&gt;&lt;hr size="1"&gt;dead-letters to the retry exchange' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="360" height="68" as="geometry"/></mxCell><mxCell id="c7" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;learning-service, manual ack&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AssessmentCompletedListener&lt;/b&gt;&lt;hr size="1"&gt;ack when applied&lt;br&gt;nack (no requeue) when it fails' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="400" height="84" as="geometry"/></mxCell><mxCell id="c8" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;direct exchange&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;learning.assessment-completed.retry&lt;/b&gt;' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="260" height="50" as="geometry"/></mxCell><mxCell id="c9" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;queue, TTL = 30 s&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;learning.assessment-completed.v2.retry&lt;/b&gt;&lt;hr size="1"&gt;on expiry dead-letters to the&lt;br&gt;default exchange, back to the main queue' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="440" height="84" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;direct exchange&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;learning.assessment-completed.dlx&lt;/b&gt;' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.6;align=center;verticalAlign=top;childLayout=stackLayout;resizeParent=1;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="1220" y="520" width="400" height="50" as="geometry"/></mxCell><mxCell id="c11" value='&lt;font style="font-size:11px"&gt;&amp;lt;&amp;lt;queue, parked messages&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;learning.assessment-completed.v2.dlq&lt;/b&gt;&lt;hr size="1"&gt;header x-learning-failure gives the reason' style="swimlane;html=1;whiteSpace=wrap;startSize=42;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;align=center;verticalAlign=top;childLa